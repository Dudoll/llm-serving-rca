.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.tmp
*.pid
*.bak/

# Large/generated benchmark outputs are ignored by default.  Raw results and
# per-sample telemetry stay local, while report-facing canonical summaries are
# explicitly retained as reviewable evidence.
artifacts/env/*
!artifacts/env/.gitkeep
artifacts/logs/
charts/*
!charts/.gitkeep
!charts/prefill-decoder-matrix.png
!charts/open-loop-saturation.png
!charts/open-loop-steady.png
results/raw/*
!results/raw/.gitkeep
results/summary/*
!results/summary/.gitkeep
!results/summary/baseline-summary.csv
!results/summary/baseline-aggregate.csv
!results/summary/gpu-telemetry-summary.csv
!results/summary/prefill-decoder-summary.csv
!results/summary/prefill-decoder-aggregate.csv
!results/summary/open-loop-summary.csv
!results/summary/open-loop-aggregate.csv
!results/summary/open-loop-telemetry-summary.csv
!results/summary/open-loop-steady-summary.csv
!results/summary/open-loop-steady-aggregate.csv
!results/summary/open-loop-steady-slo-summary.csv
!results/summary/open-loop-steady-telemetry-summary.csv
results/telemetry/

# RunBundle manifests and deterministic execution plans are reviewable Tier-1
# evidence, so results/manifests/ and results/plans/ are intentionally not
# ignored.  Global *.tmp above covers interrupted atomic manifest writes.

# Local exploratory client, superseded by benchmark/streaming_client.py.
benchmark/demo_client.py
