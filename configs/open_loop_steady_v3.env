# Phase 3b v3: strict sustainable-capacity validation target.
#
# This file is intentionally separate from open_loop_steady.env. The latter is
# the immutable Phase 3b v2 experiment definition and must remain reproducible.
#
# IMPORTANT: do not execute this spec through the legacy finite runner. v3
# requires a fixed-wall-clock load generator that stops DISPATCH at t0+300s.

RUN_NAMESPACE=phase3b-v3
RUN_ATTEMPT=1

INPUT_LEN=512
OUTPUT_LEN=128
NUM_WARMUPS=8
REPETITIONS=5

# Formal arrival window: [t0, t0 + 300s).
# New requests must not be dispatched at or after the deadline. Requests that
# were already dispatched may finish afterwards so drain evidence is retained.
ARRIVAL_WINDOW_SECONDS=300

# Ignore the first 60s only for steady-rate / queue-trend calculations. It does
# not change the formal 300s arrival boundary or request-level SLO accounting.
STEADY_WINDOW_START_SECONDS=60

# Keep the client semaphore far above the expected server concurrency. Hitting
# this cap invalidates the run because client backpressure would hide backlog.
MAX_CONCURRENCY=1024

# v2 showed instability at 10-12 req/s. v3 moves lower and keeps 10 req/s as
# the boundary control.
REQUEST_RATES="7 8 9 10"
LOADGEN_SEEDS="32001 32002 32003 32004 32005"
PLAN_SHUFFLE_SEED=20260916

# Frozen SLOs carried forward from Phase 3b v2.
TTFT_SLO_MS=200
E2E_SLO_MS=4000
TPOT_SLO_MS=

RANDOM_RANGE_RATIO=0
BETWEEN_RUN_SECONDS=8
