# Phase 3b v2: completed long-window finite validation around the Phase 3a boundary.
# Do not reuse this namespace for new executions; use a new immutable namespace
# (for example phase3b-v3) after the strict steady-window implementation lands.
RUN_NAMESPACE=phase3b-v2
RUN_ATTEMPT=1
INPUT_LEN=512
OUTPUT_LEN=128
ARRIVAL_WINDOW_SECONDS=300
NUM_WARMUPS=8
REPETITIONS=5
# Keep the client semaphore above the worst backlog projected from Phase 3a;
# otherwise client-side backpressure can hide server queue growth.
MAX_CONCURRENCY=1024
REQUEST_RATES="10 11 12"
LOADGEN_SEEDS="31001 31002 31003 31004 31005"
PLAN_SHUFFLE_SEED=20260810
# These SLO gates were frozen before the Phase 3b v2 run;
# the runner refuses to execute if either SLO is missing.
TTFT_SLO_MS=200
E2E_SLO_MS=4000
# Optional additional token cadence gate.
TPOT_SLO_MS=
RANDOM_RANGE_RATIO=0
BETWEEN_RUN_SECONDS=8
