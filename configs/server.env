# Pinned local image used for reproducible experiments.
VLLM_IMAGE=vllm/vllm-openai@sha256:ffb2d59b1c059a5bd8d781320c9f5189de8293693b7d95da54befddaa54abf52
MODEL=Qwen/Qwen3-0.6B
MODEL_REVISION=c1899de289a04d12100db370d81485cdf75e47ca
TOKENIZER_SNAPSHOT=/root/.cache/huggingface/hub/models--Qwen--Qwen3-0.6B/snapshots/c1899de289a04d12100db370d81485cdf75e47ca
CONTAINER_NAME=vllm-rca-server
# The load generator joins the server container's network namespace, so its
# destination is the inner port even when the host mapping is changed.
